local Section = Tab:CreateSection("Potion Shop")
local AutoBuyPotions = false
local SelectedPotions = {}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local PotionScrollingFrame = LocalPlayer.PlayerGui.Main.Frames.FRAMES.PotionShop.Main.Holder.ScrollingFrame
local PurchasePotion = game:GetService("ReplicatedStorage").PotionShopRemotes.PurchasePotion

-- Maps display name -> potion frame
local PotionMap = {}
local PotionOptions = {}

for _, potion in ipairs(PotionScrollingFrame:GetChildren()) do
    if potion:IsA("Frame") and potion.Name ~= "PotionTemplate" then
        local infoFrame = potion:FindFirstChild("1")
        local nameLabel = infoFrame and infoFrame:FindFirstChild("PotionName")

        if nameLabel and nameLabel:IsA("TextLabel") then
            local displayName = nameLabel.Text

            table.insert(PotionOptions, displayName)
            PotionMap[displayName] = potion
        end
    end
end

table.sort(PotionOptions)

Tab:CreateDropdown({
    Name = "Potions",
    Options = PotionOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "PotionSelection",
    Callback = function(options)
        SelectedPotions = options
    end,
})

Tab:CreateToggle({
    Name = "Auto Buy Potions",
    CurrentValue = false,
    Flag = "AutoBuyPotions",
    Callback = function(Value)
        AutoBuyPotions = Value

        task.spawn(function()
            while AutoBuyPotions do
                for _, potionName in ipairs(SelectedPotions) do
                    local potion = PotionMap[potionName]

                    if potion then
                        local purchaseFrame = potion:FindFirstChild("1")

                        if purchaseFrame then
                            local button = purchaseFrame:FindFirstChildWhichIsA("TextButton")

                            if button and button.Visible then
                                pcall(function()
                                    PurchasePotion:FireServer(potion.LayoutOrder)
                                end)
                            end
                        end
                    end
                end

                task.wait(1)
            end
        end)
    end,
})
