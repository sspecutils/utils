local controllers = ReplicatedStorage:WaitForChild("Game"):WaitForChild("Controllers")

local function removeAntiAFK()
    local antiAFK = controllers:FindFirstChild("AntiAFKController")
    if antiAFK then
        antiAFK:Destroy()
        return true
    end
    return false
end
